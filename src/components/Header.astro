---
import '../assets/css/header.scss'
import { useTranslations } from '../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);
---

<header class="header">
    <nav class="container header__container">
        <a href="#hero" class="header__logo">ALTUSZKA</a>
        <ul class="header__list">
            <li class="header__item"><a class="header__link" href="#project">{t('nav.project')}</a></li>
            <li class="header__item"><a class="header__link" href="#frontend">Frontend</a></li>
            <li class="header__item"><a class="header__link" href="#backend">Backend</a></li>
            <li class="header__item"><a class="header__link" href="#history">{t('nav.history')}</a></li>
        </ul>
    </nav>
</header>

<script>
    const header = document.querySelector('.header');

    const toggleHeaderClass = () => {
        if (!header) return;
        header.classList.toggle('header--scrolled', window.scrollY > 5);
    };

    window.addEventListener('scroll', toggleHeaderClass, { passive: true });
    toggleHeaderClass();

    const whiteSections = document.querySelectorAll('.backend-section');

    const observerOptions = {
        root: null,
        rootMargin: '-10px 0px -90% 0px', 
        threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                header?.classList.add('dark');
            } else {
                header?.classList.remove('dark');
            }
        });
    }, observerOptions);

    whiteSections.forEach(section => observer.observe(section));
</script>