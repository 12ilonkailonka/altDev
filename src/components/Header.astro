---
import '../assets/css/header.scss'
---

<header class="header">
    <nav class="container header__container">
        <a href="/" class="header__logo">ALTUSZKA</a>
        <ul class="header__list">
            <li class="header__item"><a class="header__link" href="#project">Проект</a></li>
            <li class="header__item"><a class="header__link" href="#frontend">Frontend</a></li>
            <li class="header__item"><a class="header__link" href="#backend">Backend</a></li>
            <li class="header__item"><a class="header__link" href="#history">История</a></li>
            <li class="header__item"><a class="header__link" href="#developers">Команда</a></li>
        </ul>
    </nav>
</header>

<script>
    const header = document.querySelector('header');

    const toggleHeaderClass = () => {
        if (!header) return;
        
        if (window.scrollY > 5) {
            header.classList.add('header--scrolled');
        } else {
            header.classList.remove('header--scrolled');
        }
    };

    window.addEventListener('scroll', toggleHeaderClass, { passive: true });
    
    toggleHeaderClass();
</script>