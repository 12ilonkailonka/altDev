---
import { useTranslations } from '../../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);
---
<section class="page backend-section" id="backend">
<div class="container">

    <div class="backend-grid">
         <ol class="backend-grid__item item_1">

            <li class="backend-grid__card">
                <p class="card__number">01</p>
                <h3 class="card__title">Fast API</h3>
                <p class="card__text">{t('back.text1')}<span class="accent">{t('back.text2')}</span>{t('back.text3')}</p>
            </li>

            <li class="backend-grid__card">
                <p class="card__number">02</p>
                <h3 class="card__title">Python</h3>
                <p class="card__text">{t('back.text4')}</p>
            </li>

            <li class="backend-grid__card">
                <p class="card__number">03</p>
                <h3 class="card__title">PostgreSQL</h3>
                <p class="card__text">{t('back.text5')}</p>
            </li>

         </ol>

         <div class="backend-grid__item item_2">
            
            <div class="section-meta meta-right">
                <p class="section-meta__number">02</p>
                <p class="section-meta__name">Frontend</p>
            </div>

            <h2 class="backend-section__title">{t('back.title')}</h2>
            <p class="backend-section__text">{t('back.text6')}<span>{t('back.text7')}</span>{t('back.text8')}<span>{t('back.text9')}</span>{t('back.text10')}<span>{t('back.text11')}</span><br><br> {t('back.text12')}</p>

         </div>
    </div>

    <hr>

    <div class="quote__wrapper">
        <span class="quote__quotation-mark">“</span>
        <blockquote class="quote__text">{t('back.text13')}</blockquote>
    </div>

</div>

</section>