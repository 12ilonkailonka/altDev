---
import { Image } from 'astro:assets';
import publish from '../../assets/media/ico/publish.svg';
import community from '../../assets/media/ico/community.svg';
import talk from '../../assets/media/ico/talk.svg';
import book from '../../assets/media/ico/book.svg';
import { useTranslations } from '../../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);
---
<section class="page project-section" id="project">
<div class="container">

    <div class="section-meta">
        <p class="section-meta__number">01</p>
        <p class="section-meta__name">{t('project.whatIsIt')} Altuszka</p>
    </div>

    <h2 class="project-section__title">{t('project.platform')}</h2>

    <article class="project-section__grid">

         <p class="project-section__text-big">{t('project.textBig1')}<span>{t('project.textBig2')}</span>, {t('project.textBig3')}</p>

        <div class="project-section__item">
            <p class="project-section__text-small">{t('project.textSmall1')}</p>
            <p class="project-section__text-small">{t('project.textSmall2')}</p>
        </div>
    </article>

    <ul class="project-section__points">
        <li class="project-section__point">
            <p class="point__number">01</p>
            <Image class="point__ico" src={book} alt="" aria-hidden="true"/>
            <h3 class="point__title">{t('project.publications')}</h3>
            <p class="point__text">{t('project.text1')}</p>
        </li>

        <li class="project-section__point">
            <p class="point__number">02</p>
            <Image class="point__ico" src={community} alt="" aria-hidden="true"/>
            <h3 class="point__title">{t('project.community')}</h3>
            <p class="point__text">{t('project.text2')}</p>
        </li>

        <li class="project-section__point">
            <p class="point__number">03</p>
            <Image class="point__ico" src={talk} alt="" aria-hidden="true"/>
            <h3 class="point__title">{t('project.talk')}</h3>
            <p class="point__text">{t('project.text3')}</p>
        </li>

        <li class="project-section__point blue">
            <p class="point__number white">04</p>
            <Image class="point__ico white" src={publish} alt="" aria-hidden="true"/>
            <h3 class="point__title white">{t('project.connect')}</h3>
            <p class="point__text white">{t('project.text4')}</p>
        </li>
    </ul>


</div>
</section>