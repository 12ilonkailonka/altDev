---
import { Image } from 'astro:assets';
import bc from '../../assets/media/bc.jpg';
import mara from '../../assets/media/mara.png';
import { useTranslations } from '../../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);
---
<section class="page history-section" id="history">
<div class="container">

    <div class="history-section__grid">

        <div class="section-item section-meta">
            <p class="section-meta__number">04</p>
            <p class="section-meta__name">{t('history.title1')}</p>
        </div>

        <div class="section-item">
            <h2 class="history-section__title">{t('history.title2')}</h2>

            <p class="history-section__subtitle">{t('history.text1')}</p>

            <p class="history-section__text">{t('history.text2')}</p>

            <p class="history-section__text">{t('history.text3')}</p>

            <p class="history-section__text">{t('history.text4')}<span>{t('history.text5')}</span>{t('history.text6')}<span>{t('history.text7')}</span></p>

            <hr>
        </div>

    </div>

    <div class="timeline">
        <article class="timeline__era">
            <p class="timeline__year year_1">2024</p>

            <h2 class="timeline__title right">{t('history.title3')}</h2>
            <div class="timeline__grid right">
                <div class="timeline__grid-item">
                    <p class="timeline__text accent">{t('history.text8')}<br>{t('history.text9')}<br>{t('history.text10')}<br>{t('history.text11')}</p>
                </div>
                <div class="timeline__grid-item">
                    <p class="timeline__text">{t('history.text12')}</p>
                    <p class="timeline__text">{t('history.text13')}</p>
                </div>
            </div>

        </article>
        <article class="timeline__era">
            <p class="timeline__year year_2">2025</p>
            <h2 class="timeline__title">{t('history.title4')}</h2>

            <div class="timeline__grid">
                <div class="timeline__grid-item">
                    <p class="timeline__text">{t('history.text14')}</p>
                    <p class="timeline__text">{t('history.text15')}</p>
                    <p class="timeline__text">{t('history.text16')}</p>
                </div>
                <div class="timeline__grid-item">
                    <Image src={mara} alt="Марина рисует сайт" />
                </div>
            </div>
        </article>
        <article class="timeline__era">
            <p class="timeline__year year_3">2026</p>
            <h2 class="timeline__title right">{t('history.title5')}</h2>

            <div class="timeline__grid right">
                <div class="timeline__grid-item">
                    <p class="timeline__text accent">{t('history.text17')}<br>{t('history.text18')}<br>{t('history.text19')}<br>{t('history.text20')}</p>
                </div>
                <div class="timeline__grid-item">
                    <p class="timeline__text">{t('history.text21')}</p>
                </div>
            </div>
        </article>
        <article class="timeline__era">
            <p class="timeline__year year_4">2027</p>
            <h2 class="timeline__title">{t('history.title6')}</h2>

            <div class="timeline__grid">
                <div class="timeline__grid-item">
                    <p class="timeline__text">{t('history.text22')}</p>
                    <p class="timeline__text">{t('history.text23')}</p>
                    <p class="timeline__text">{t('history.text24')}</p>
                </div>
                <div class="timeline__grid-item">
                    <Image src={bc} alt="Команда разработки" />
                </div>
            </div>
        </article>
    </div>

</div>
</section>

<script>
  function setupTimelineAnimation() {
    const eras = document.querySelectorAll<HTMLElement>('.timeline__era');

    eras.forEach((era) => {
      const year = era.querySelector('.timeline__year');
      const items = era.querySelectorAll('.timeline__grid-item');

      year?.classList.add('hidden');
      items.forEach((item) => item.classList.add('hidden'));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const target = entry.target;
                const year = target.querySelector('.timeline__year');
                const items = target.querySelectorAll('.timeline__grid-item');

                year?.classList.remove('hidden');
                items.forEach((item) => item.classList.remove('hidden'));
            } else { 
                const target = entry.target;
                const year = target.querySelector('.timeline__year');
                const items = target.querySelectorAll('.timeline__grid-item');

                year?.classList.add('hidden');
                items.forEach((item) => item.classList.add('hidden'));
            }
        });
      },
      {
        threshold: 0.25,
        rootMargin: '0px 0px -50px 0px',
      }
    );

    eras.forEach((era) => observer.observe(era));
  }

  setupTimelineAnimation();
  document.addEventListener('astro:page-load', setupTimelineAnimation);
</script>