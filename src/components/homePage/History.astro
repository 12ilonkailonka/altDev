---
import { Image } from 'astro:assets';
import bd from '../../assets/media/bd.jpg';
import mara from '../../assets/media/mara.png';
---
<section class="page history-section" id="history">
<div class="container">

    <div class="history-section__grid">

        <div class="section-item section-meta">
            <p class="section-meta__number">04</p>
            <p class="section-meta__name">Немного истории</p>
        </div>

        <div class="section-item">
            <h2 class="history-section__title">Интернет уже умел быть сообществом.</h2>

            <p class="history-section__subtitle">
                Старые форумы были неудобными, шумными, местами совершенно 
                дикими — и при этом удивительно человеческими.
            </p>

            <p class="history-section__text">
                Там можно было прийти ради ответа на один вопрос, остаться ради разговора 
                и через несколько месяцев внезапно знать половину постоянных участников по никам.
            </p>

            <p class="history-section__text">
                Современные платформы стали быстрее, красивее и гораздо умнее. 
                Но вместе с этим пространство между людьми постепенно заняли 
                рекомендации, метрики удержания и алгоритмические ленты.
            </p>

            <p class="history-section__text">
                Алгоритм отлично понимает, что вам, вероятно, <span>понравится</span>. 
                И именно поэтому слишком редко показывает то, что может <span>удивить</span>.
            </p>

            <hr>
        </div>

    </div>

    <div class="timeline">
        <article class="timeline__era">
            <p class="timeline__year year_1">2024</p>

            <h2 class="timeline__title right">Идея</h2>
            <div class="timeline__grid right">
                <div class="timeline__grid-item">
                    <p class="timeline__text accent">
                        Тоска рождает идею. <br>
                        Идея рождает мечту. <br>
                        Мечта рождает стремление. <br>
                        Стремление меняет наш мир.
                    </p>
                </div>
                <div class="timeline__grid-item">
                    <p class="timeline__text">
                        Литература штука локальная. Её можно переводить, но никакой перевод не обеспечит
                        наличие культурного контекста. Мы считаем развитие литературы своей культуры 
                        ценностью, поэтому и решили создать платформу, которая поспособствует этому.
                    </p>
                    <p class="timeline__text">
                        Мы начали с маленького сайта на WordPress, чтобы понять, имеет ли начинание смысл. 

                    </p>
                </div>
            </div>

        </article>
        <article class="timeline__era">
            <p class="timeline__year year_2">2025</p>
            <h2 class="timeline__title">Первые шаги</h2>

            <div class="timeline__grid">
                <div class="timeline__grid-item">
                    <p class="timeline__text">
                        Быстро стало понятно, что WordPress для серьёзной платформы совершенно не 
                        подходит — настроить и доработать его под свои нужды сложнее, чем сделать 
                        всё с нуля.
                    </p>
                    <p class="timeline__text">
                        Команда взялась за код. Было сделано несколько пробных версий, пока в конечном 
                        счёте мы не осознали реальный масштаб проекта и не пришли к по-настоящему 
                        серьёзному подходу.
                    </p>
                    <p class="timeline__text">
                        Полноценное фронтэнд приложение, полноценный бэкэнд сервер, богатый опыт 
                        взаимодействия, правильный дизайн, который не утомляет и позволяет быстро и удобно
                        взаимодействовать с сайтом
                    </p>
                </div>
                <div class="timeline__grid-item">
                    <Image src={mara} alt="Марина рисует сайт" />
                </div>
            </div>
        </article>
        <article class="timeline__era">
            <p class="timeline__year year_3">2026</p>
            <h2 class="timeline__title right">Разработка</h2>

            <div class="timeline__grid right">
                <div class="timeline__grid-item">
                    <p class="timeline__text accent">
                        HTML — структурен. <br>
                        CSS — изящен. <br>
                        TypeScript — надёжен. <br>
                        Python — красив.
                    </p>
                </div>
                <div class="timeline__grid-item">
                    <p class="timeline__text">
                        И вот все звёзды сошлись, шестерёнки завертелись и мы взялись за активную работу
                        по созданию и настройке платформы. Так родился этот сайт, где мы будем 
                        публиковать новости хода разработки для своих, кому интересна судьба проекта.
                    </p>
                </div>
            </div>
        </article>
        <article class="timeline__era">
            <p class="timeline__year year_4">2027</p>
            <h2 class="timeline__title">Релиз</h2>

            <div class="timeline__grid">
                <div class="timeline__grid-item">
                    <p class="timeline__text">
                        Рассчитываем на публикацию готового приложения в начале 2027 года.
                    </p>
                    <p class="timeline__text">
                        Первая версия будет призвана обкатать проект, найти первую аудиторию, 
                        исправить все потенциальные ошибки и перейти к устойчивому развитию.
                    </p>
                    <p class="timeline__text">
                        Рабочий вариант проекта — лучше тысячи статей о том, каким он будет.
                    </p>
                </div>
                <div class="timeline__grid-item">
                    <Image src={bd} alt="Команда разработки" />
                </div>
            </div>
        </article>
    </div>

</div>
</section>

<script>
  function setupTimelineAnimation() {
    const eras = document.querySelectorAll<HTMLElement>('.timeline__era');

    eras.forEach((era) => {
      const year = era.querySelector('.timeline__year');
      const items = era.querySelectorAll('.timeline__grid-item');

      year?.classList.add('hidden');
      items.forEach((item) => item.classList.add('hidden'));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                const target = entry.target;
                const year = target.querySelector('.timeline__year');
                const items = target.querySelectorAll('.timeline__grid-item');

                year?.classList.remove('hidden');
                items.forEach((item) => item.classList.remove('hidden'));
            } else { 
                const target = entry.target;
                const year = target.querySelector('.timeline__year');
                const items = target.querySelectorAll('.timeline__grid-item');

                year?.classList.add('hidden');
                items.forEach((item) => item.classList.add('hidden'));
            }
        });
      },
      {
        threshold: 0.25,
        rootMargin: '0px 0px -50px 0px',
      }
    );

    eras.forEach((era) => observer.observe(era));
  }

  setupTimelineAnimation();
  document.addEventListener('astro:page-load', setupTimelineAnimation);
</script>