---
import Code from './Code.astro'
import Code2 from './Code2.astro'
import { useTranslations } from '../../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);
---
<section class="page frontend-section" id="frontend">
<div class="container">

    <div class="frontend-grid">

        <div class="frontend-grid__item item_1">
            <div class="section-meta meta-horizontal">
                <p class="section-meta__number">02</p>
                <p class="section-meta__name">Frontend</p>
            </div>
            <h2 class="frontend-grid__title">{t('front.title')}</h2>
            <p class="frontend-grid__text">{t('front.text1')}</p>

            <ul class="frontend-grid__technologies">
                <li class="frontend-grid__technology">Vue.js</li>
                <li class="frontend-grid__technology">SCSS</li>
                <li class="frontend-grid__technology">TypeScript</li>
                <li class="frontend-grid__technology">Viola Design</li>
            </ul>
        </div>

        <ol class="frontend-grid__item item_2">

            <li class="frontend-grid__card">
                <p class="card__number">01</p>
                <h3 class="card__title">{t('front.design')}</h3>
                <p class="card__text">{t('front.text2')}</p>
                <p class="card__text">{t('front.text3')}<span>{t('front.text4')}</span>{t('front.text5')}<span>{t('front.text6')}</span>{t('front.text7')}<span>{t('front.text8')}</span>
                </p>
            </li>

            <li class="frontend-grid__card">
                <p class="card__number">02</p>
                <h3 class="card__title">Maryna Sans</h3>
                <p class="card__text">{t('front.text9')}<span class="accent">{t('front.text10')}</span>{t('front.text11')}
                </p>
                <p class="card__text">{t('front.text12')}<span class="accent">{t('front.text13')}</span>{t('front.text14')}</p>
            </li>

            <li class="frontend-grid__card">
                <p class="card__number">03</p>
                <h3 class="card__title">SCSS</h3>
                <p class="card__text">{t('front.text15')}</p>
                <Code />
            </li>

            <li class="frontend-grid__card">
                <p class="card__number">04</p>
                <h3 class="card__title">Vue.js</h3>
                <p class="card__text">{t('front.text16')}</p>
                <Code2 />
            </li>

        </ol>

    </div>

</div>
</section>