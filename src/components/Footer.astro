---
import '../assets/css/footer.scss'
import { useTranslations } from '../i18n/utils';
const locale = Astro.currentLocale ?? 'ua';
const t = useTranslations(locale);

const currentYear = new Date().getFullYear().toString();

const devs = ['maryna', 'oxana', 'ala', 'dasza'] as const;;
const randomDevKey = devs[Math.floor(Math.random() * devs.length)];
---
<footer class="footer">

<section class="disclamer">
    <div class="container disclamer__container">
        <ol class="disclamer__list">
            <li class="disclamer__item">{t('footer.disclamer1')}</li>
            <li class="disclamer__item">{t('footer.disclamer2')}</li>
            <li class="disclamer__item">{t('footer.disclamer3')}</li>
        </ol>
    </div>
</section>

<section class="footer-content">
    <div class="container footer-content__wrapper">
        <p class="footer-content__copyright">Altuszka &copy; 2024–{currentYear}. {t('footer.copyright')}</p>
        <p class="footer-content__love">{t('footer.love')} {t(`footer.developer.${randomDevKey}`)}</p>
    </div>  
</section>
</footer>

<script>
    
</script>